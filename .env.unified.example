# Unified Single Environment File Template for المِلّة (Al-Millah)
# Copy this file to `.env.unified` (gitignored), fill in your secrets once,
# and run `pnpm env:sync` (or `pnpm env:sync:dev|staging|prod`) to generate
# filtered `.env.*` files for root/api/database, web, landing, and mobile.

[common]
# Database (Supabase Postgres)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Security / Auth / Rate Limiting
JWT_SECRET=<replace-with-32+-char-random-secret>
COOKIE_SECRET=<replace-with-32+-char-random-secret>
CRON_SECRET=<replace-with-random-secret>
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Prisma Build Helpers
PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1
PRISMA_ENGINES_MIRROR=https://binaries.prisma.sh

# Web Public App Defaults
NEXT_PUBLIC_DEFAULT_THEME=light
NEXT_PUBLIC_APP_PREFERENCES_STORAGE_KEY=almilla.preferences
NEXT_PUBLIC_APP_AUTH_STORAGE_KEY=almilla.auth
NEXT_PUBLIC_DEFAULT_SIGNUP_ROLE=USER

[development]
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3002
EXPO_PUBLIC_API_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
SUPABASE_EMAIL_REDIRECT_URL=http://localhost:3001/auth/callback
SUPABASE_RESET_REDIRECT_URL=http://localhost:3001/auth/reset-password
SUPABASE_OAUTH_REDIRECT_URL=http://localhost:3001/auth/callback

[staging]
NODE_ENV=staging
PORT=3000
API_URL=https://al-milla-api-khalils-projects-48833437.vercel.app
WEB_URL=https://al-milla.vercel.app
NEXT_PUBLIC_API_URL=https://al-milla-api-khalils-projects-48833437.vercel.app
NEXT_PUBLIC_APP_URL=https://al-milla.vercel.app
NEXT_PUBLIC_SITE_URL=https://al-milla-landing-khalils-projects-48833437.vercel.app
EXPO_PUBLIC_API_URL=https://al-milla-api-khalils-projects-48833437.vercel.app
ALLOWED_ORIGINS=https://al-milla.vercel.app,https://al-milla-landing-khalils-projects-48833437.vercel.app,https://app.al-milla.khalilbchir.pro,https://al-milla.khalilbchir.pro
SUPABASE_EMAIL_REDIRECT_URL=https://al-milla.vercel.app/auth/callback
SUPABASE_RESET_REDIRECT_URL=https://al-milla.vercel.app/auth/reset-password
SUPABASE_OAUTH_REDIRECT_URL=https://al-milla.vercel.app/auth/callback

[production]
NODE_ENV=production
PORT=3000
API_URL=https://api-al-milla.khalilbchir.pro
WEB_URL=https://app.al-milla.khalilbchir.pro
NEXT_PUBLIC_API_URL=https://api-al-milla.khalilbchir.pro
NEXT_PUBLIC_APP_URL=https://app.al-milla.khalilbchir.pro
NEXT_PUBLIC_SITE_URL=https://al-milla.khalilbchir.pro
EXPO_PUBLIC_API_URL=https://api-al-milla.khalilbchir.pro
ALLOWED_ORIGINS=https://app.al-milla.khalilbchir.pro,https://al-milla.khalilbchir.pro,https://al-milla.vercel.app
SUPABASE_EMAIL_REDIRECT_URL=https://app.al-milla.khalilbchir.pro/auth/callback
SUPABASE_RESET_REDIRECT_URL=https://app.al-milla.khalilbchir.pro/auth/reset-password
SUPABASE_OAUTH_REDIRECT_URL=https://app.al-milla.khalilbchir.pro/auth/callback
