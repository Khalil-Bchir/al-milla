{
  "expo": {
    "name": "المِلّة",
    "slug": "al-milla",
    "version": "1.0.0",
    "scheme": "almilla",
    "orientation": "portrait",
    "icon": "./assets/images/al-milla-logo.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/al-milla-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F5ED",
      "dark": {
        "image": "./assets/images/al-milla-logo-dark.jpg",
        "resizeMode": "contain",
        "backgroundColor": "#0B0B0A"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.almilla.app"
    },
    "android": {
      "package": "com.almilla.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/al-milla-logo.png",
        "backgroundColor": "#F7F5ED"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-audio",
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5ED",
          "image": "./assets/images/al-milla-logo.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0B0B0A",
            "image": "./assets/images/al-milla-logo-dark.jpg"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b637aae0-f92a-44f2-bed5-4e9857ab776b"
      }
    },
    "owner": "lilka",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b637aae0-f92a-44f2-bed5-4e9857ab776b",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 4000,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
