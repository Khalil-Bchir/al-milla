{
  "expo": {
    "name": "المِلّة",
    "slug": "al-milla",
    "version": "1.0.0",
    "scheme": "almilla",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.almilla.app"
    },
    "android": {
      "package": "com.almilla.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F5ED"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
