datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String           @id @default(uuid())
  email         String           @unique
  fullName      String?
  phone         String?
  streetAddress String?
  city          String?
  state         String?
  postalCode    String?
  country       String?
  role          UserRole         @default(USER)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  portfolios    HafizPortfolio[]

  @@index([email])
  @@map("users")
}

enum UserRole {
  USER
  ADMIN
  DEMO
}

model Review {
  id        String   @id @default(uuid())
  name      String
  company   String?
  rating    Int
  title     String?
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("reviews")
}

/// Lightweight 1-row-per-learner cloud backup for Supabase Free Tier.
/// Quran texts, audio, UI theme/font preferences, and session logs stay 100% local.
model HafizPortfolio {
  id             String   @id @default(uuid())
  syncKey        String   @unique
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  narration      String   @default("qalun")
  dailyTarget    Int      @default(4)
  currentSurahId Int      @default(18)
  currentAyah    Int      @default(1)
  snapshot       Json     @default("{}")
  updatedAt      DateTime @updatedAt

  @@index([syncKey])
  @@map("hafiz_portfolios")
}

enum FeedbackType {
  BUG
  FEEDBACK
}

model FeedbackReport {
  id         String       @id @default(uuid())
  type       FeedbackType @default(FEEDBACK)
  area       String?
  message    String
  contact    String?
  deviceInfo String?
  appVersion String?
  syncKey    String?
  createdAt  DateTime     @default(now())

  @@index([createdAt])
  @@index([type])
  @@map("feedback_reports")
}
